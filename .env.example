# Environment Configuration for Delta AI Support Agent & Evaluation Suite
# Copy this file to .env and insert your API keys if you wish to run live LLM calls.
# Note: The pipeline executes 100% deterministically and offline by default if keys are omitted.

# OpenAI API Key (Optional: for GPT-4o-mini drafting / judging)
OPENAI_API_KEY=

# Google Gemini API Key (Optional: for Gemini-1.5-flash drafting / judging)
GEMINI_API_KEY=

# Alternative Google API Key variable name
GOOGLE_API_KEY=

# Groq API Key (Optional)
GROQ_API_KEY=
